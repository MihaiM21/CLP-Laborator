module mux_2_1 (
    input  a_i,   // intrarea a
    input  b_i,   // intrarea b
    input  s_i,   // intrarea c
    output y_o    // iesirea y
);

// Scrieti codul mai jos pentru rezolvarea laboratorului
assign y_o = (~s_i & a_1) | (s_i & b_i);


endmodule



